<Window x:Class="CyberGuardBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberGuardBot"
        Height="650"
        Width="900"
        MinHeight="500"
        MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Background="#FFF9EF"
        Closed="Window_Closed">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#17243A"
                CornerRadius="10"
                Padding="18"
                Margin="0,0,0,15">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <TextBlock Text="CyberGuardBot"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Your Cybersecurity Assistant"
                               FontSize="14"
                               Foreground="#E6EAF0"
                               Margin="0,5,0,0"/>

                    <TextBlock Text="Greeting sound only"
                               FontSize="12"
                               Foreground="#D6DCE5"
                               Margin="0,5,0,0"/>

                </StackPanel>

                <Button Grid.Column="1"
                        Content="Topics"
                        Click="HelpButton_Click"
                        Padding="15,8"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Background="#FFF9EF"
                        Foreground="#17243A"
                        BorderThickness="0"
                        Cursor="Hand"/>

            </Grid>
        </Border>

        <!-- Conversation Area -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D8CFBF"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12"
                Margin="0,0,0,12">

            <ScrollViewer x:Name="ConversationScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel x:Name="ConversationPanel"/>

            </ScrollViewer>
        </Border>

        <!-- Message Input and Send Button -->
        <Grid Grid.Row="2"
              Margin="0,0,0,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="MessageTextBox"
                     Grid.Column="0"
                     MinHeight="45"
                     Padding="12"
                     FontSize="14"
                     VerticalContentAlignment="Center"
                     TextWrapping="Wrap"
                     AcceptsReturn="False"
                     PreviewKeyDown="MessageTextBox_PreviewKeyDown"
                     BorderBrush="#D8CFBF"
                     BorderThickness="1"
                     Background="White"
                     Foreground="#17243A"/>

            <Button Grid.Column="1"
                    Content="Send"
                    Click="SendButton_Click"
                    MinWidth="90"
                    Margin="10,0,0,0"
                    Padding="18,8"
                    Background="#17243A"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="Bold"
                    Cursor="Hand"/>

        </Grid>

        <!-- Status Text -->
        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="3"
                   Text="Ready"
                   FontSize="12"
                   Foreground="#686D78"
                   Margin="0,0,0,8"/>

        <!-- Clear Chat Button -->
        <Button Grid.Row="4"
                Content="Clear Chat"
                Click="ClearButton_Click"
                HorizontalAlignment="Right"
                Padding="15,7"
                Background="#E9E2D6"
                Foreground="#17243A"
                BorderThickness="0"
                Cursor="Hand"/>

    </Grid>
</Window>
